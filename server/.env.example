# Saraswati Motors — Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas connection string or left empty for In-Memory DB in dev)
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_here

# Client Origin URL for CORS
CLIENT_URL=http://localhost:5173

# Hardcoded Registered Admin Phone Number for OTP Password Reset
ADMIN_PHONE=+91 98117 98761

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin@123$

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMS Gateway Configurations (e.g., Fast2SMS / Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
